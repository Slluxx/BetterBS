{
  "name": "BetterBS",
  "description": "BetterBS turns the outdated page into a fresh new design with many QOL features.",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "buildprod": "wxt build --mode production",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all" : "wxt zip && wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "publish:init": "wxt submit init",
    "publish": "wxt submit",
    "publish:test": "publish-extension --chrome-zip .output\\betterbs-1.0.0-chrome.zip"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.29",
    "vue-router": "^5.2.0",
    "vue3-carousel": "^0.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "wxt": "^0.20.27"
  }
}